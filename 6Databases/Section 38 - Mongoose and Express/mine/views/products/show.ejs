<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHOW OPERATION</title>
</head>

<body>
    <h1><%= foundProduct.name %>
    </h1>
    <ul>
        <li>Price: <%=foundProduct.price%>
        </li>
        <li>Category: <%=foundProduct.category%>
        </li>
        <li>Id: <%=foundProduct.id%>
        </li>
    </ul>
    <a href="/products">
        Return to INDEX page
    </a>
    <br>
    <a href="/products/<%= foundProduct._id %>/edit">
        Edit Product
    </a>

    <form action="/products/<%= foundProduct._id%>?_method=DELETE" method="POST">
        <button>DELETE</button>
    </form>
</body>

</html>